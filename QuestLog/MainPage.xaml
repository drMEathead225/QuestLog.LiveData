<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QuestLog"
             x:Class="QuestLog.MainPage"
             Title="Quest Log">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="24"
          RowSpacing="14">

        <Label Grid.Row="0"
               Text="Quest Log"
               FontSize="30"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="CountLabel"
               Text="0 quests"
               FontSize="14"
               TextColor="Gray" />

        <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" Padding="4">

            <CollectionView ItemsSource="{Binding Quests}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedQuest, Mode=TwoWay}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Quest">
                        <VerticalStackLayout Padding="12,8">
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Giver, StringFormat='Given by {0}'}"
                                   FontSize="13" TextColor="Gray" />
                            <Label Text="{Binding Reward, StringFormat='Reward: {0} gold'}"
                                   FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No quests yet."
                           FontSize="16" TextColor="Gray"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>

            </CollectionView>
        </Border>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Entry x:Name="TitleEntry" Placeholder="Quest title" />
            <Entry x:Name="GiverEntry" Placeholder="Quest giver" />
            <Entry x:Name="RewardEntry" Placeholder="Reward (gold)" Keyboard="Numeric" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Add quest" Clicked="OnAddClicked" />
                <Button Grid.Column="1" Text="Remove selected" Clicked="OnRemoveClicked" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>